{
  "manifest_version": 3,
  "name": "Relève",
  "short_name": "Relève",
  "version": "5.2.3",
  "description": "Avis de CFE et de taxe foncière de tous vos clients, analysés et classés par urgence, depuis votre espace professionnel impots.gouv. Données conservées sur votre poste.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://cfspro.impots.gouv.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Relève",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cfspro.impots.gouv.fr/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "homepage_url": "https://releveavis.netlify.app/",
  "author": "Romain Froment"
}